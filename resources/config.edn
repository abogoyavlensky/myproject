{:myproject.db/db
 {:jdbc-url #profile {:default #env DATABASE_URL
                      :dev "jdbc:postgresql://localhost:5432/localdb?user=test&password=test"
                      :test "jdbc:tc:postgresql:15.2-alpine3.17:///testdb?TC_DAEMON=true"}}

 :myproject.server/server
 {:options {:port #profile {:default 8000
                            :prod 80
                            :test #free-port true}
            :session-secret-key #profile {:default "test-secret-key"
                                          :prod #env SESSION_SECRET_KEY}
            :auto-reload? #profile {:default false
                                    :dev true}
            :cache-assets? #profile {:default false
                                     :prod true}}
  :db #ig/ref :myproject.db/db}}
